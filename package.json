{
  "name": "ultron",
  "private": true,
  "version": "1.0.0",
  "description": "Ultron: a secure personal voice, vision and desktop assistant (built on AIRA by Arvind Kumar)",
  "author": "Ultron contributors (based on AIRA by Arvind Kumar, @arvindcodex)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "electron": "electron .",
    "electron:build:mac": "npm run build && electron-builder --mac dir --config.mac.identity=null",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "lint": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts && python3 -I -m unittest discover -s tests -p \"test_*.py\"",
    "audit": "npm audit --omit=dev"
  },
  "build": {
    "appId": "com.ultron.assistant",
    "productName": "Silvia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!aicop/**",
      "!data/**",
      "!**/.env*"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python"
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Silvia needs microphone access for live voice conversation.",
        "NSCameraUsageDescription": "Ultron needs camera access for emotion awareness and visual understanding.",
        "NSAppleEventsUsageDescription": "Ultron needs Automation access to control macOS applications and system workflows.",
        "NSScreenCaptureUsageDescription": "Ultron needs Screen Recording access so its vision agent can read your screen and assist you."
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.29.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^0.6.3",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "^5.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "license": "Apache-2.0",
  "overrides": {
    "qs": "^6.17.1"
  }
}
