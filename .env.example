# Your Gemini API key. Read only by the local Ultron backend; never sent to the browser.
GEMINI_API_KEY=""

# Optional. The only folder Ultron may read or write.
# ULTRON_WORKSPACE="~/UltronWorkspace"

# Optional. Unofficial WhatsApp bridge (Baileys); can get your number banned.
# ULTRON_ENABLE_WHATSAPP=1

# Full Control mode: the AI may run any shell command, use Terminal and
# change any file in your home folder WITHOUT asking. Everything is logged.
# Only works when Ultron is reachable from this computer alone.
ULTRON_FULL_CONTROL=1
