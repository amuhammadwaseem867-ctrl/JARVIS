# Your Gemini API key. Read only by the local Ultron backend; never sent to the browser.
GEMINI_API_KEY=""

# Optional. The only folder Ultron may read or write.
# ULTRON_WORKSPACE="~/UltronWorkspace"

# Optional. Unofficial WhatsApp bridge (Baileys); can get your number banned.
# ULTRON_ENABLE_WHATSAPP=1

# Full Control mode: the AI may run any shell command, use Terminal and
# change any file in your home folder WITHOUT asking. Everything is logged.
# Only works when Ultron is reachable from this computer alone.
ULTRON_FULL_CONTROL=1

# Say "Ultron" to switch it on, no typing or Start button. Needs, once:
#   python3 -m pip install faster-whisper sounddevice numpy
# Speech is transcribed on this computer; nothing is sent anywhere.
ULTRON_WAKE=1
# ULTRON_WAKE_MODEL="base"          # tiny = faster, small = more accurate
# ULTRON_WAKE_SENSITIVITY="0.012"   # lower = picks up quieter voices

# Desktop app starts hidden at login (tray icon). Set 0 to turn off.
# ULTRON_AUTOSTART=1

# Use Ultron from an iPhone or Android phone on the same Wi-Fi.
# Pair from "Connect phone" on the computer (QR code or 6-digit code).
ULTRON_PHONE=1
# ULTRON_PHONE_PORT=3443
# ULTRON_LAN_IP="192.168.1.20"      # only if the wrong network address is picked
